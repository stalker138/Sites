<Files ~ "^(recip.txt|config.inc|footer.inc|form.inc|header.inc)$">
  deny from all
</Files>
DirectoryIndex index.html index.htm index.php
AddDefaultCharset utf-8
RewriteEngine On
RewriteRule ^.htaccess$ -[F]

RewriteCond %{HTTP_HOST} ^www.teohim.kg$ [NC]
RewriteRule ^(.*)$ https://teohim.kg/$1 [R=301,L]

RewriteCond %{HTTP:X-HTTPS} !1
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(php|htm|html)\ HTTP/ 
RewriteRule ^index\.(php|htm|html)$ https://teohim.kg/ [R=301,L]
RewriteCond %{THE_REQUEST} ^(.*)\/index\.(php|htm|html)\ HTTP/ 
RewriteRule ^(.*)\/index\.(php|htm|html)$ https://teohim.kg/$1/ [R=301,L]

ErrorDocument 404 /
ErrorDocument 403 /
