        ";
        echo "<div class='obj note'>";
        echo "<div id='hdr' class='hdr'> Описание объекта: </div>";    
        echo "<div>Площадь: ".$row['area']." м2<br>Адрес: ".$row['adres']."</div><div class='hdr'>Тип пола и покрытия:</div>";
        if($row['typepokr1']==""){ echo "<br>"; }
            else { echo "1. <a class='' href='".$row['href1']."'>".$row['typepokr1']."</a><br>"; }
        if($row['typepokr2']==""){ echo "<br>"; }
            else { echo "2. <a class='' href='".$row['href2']."'>".$row['typepokr2']."</a><br>"; }
        if($row['typepokr3']==""){ echo "<br>"; }
            else { echo "3. <a class='' href='".$row['href3']."'>".$row['typepokr3']."</a><br>"; }
        if($row['typepokr4']==""){ echo "<br>"; }
            else { echo "4. <a class='' href='".$row['href4']."'>".$row['typepokr4']."</a><br>"; }
        if($row['typepokr5']==""){ echo "<br>"; }
            else { echo "5. <a class='' href='".$row['href5']."'>".$row['typepokr5']."</a><br>"; }
        echo "</div>";
        echo "<div id='cor".$row['id']."' class='fot note foto-class'>";
        $ret=Array();
        $sql="SELECT o.id as id, 
                     p.path as pict,
                     o.descr as descr,
                     o.num as num,
                     o.dateofjob as datepic 
                     FROM jobs as o 
        LEFT JOIN pics as p on p.id=o.pict              
        WHERE o.obj = ".$row['id']."
        ORDER BY o.num Desc";
        $res = $db->query($sql);
        if($res!=''){
            while($rowpic = $res->fetchArray(SQLITE3_ASSOC))
