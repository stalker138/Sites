        }
        foreach($ret as $rowp){
            echo "<div><a class='group".$row['id']."' rel='group1' caption='<strong>".$rowp["datepic"]."</strong><br>".$rowp["descr"]."' href='".str_replace('..','/admobj',$rowp["pict"])."'><img src='".str_replace('..','/admobj',$rowp["pict"])."' width='120' height='120' 
            /></a><div class='descr'><strong>".$rowp["datepic"]."</strong><br>".$rowp["descr"]."</div></div>
            ";
        }
        echo "</div></fieldset>";
        echo "<div class='clearBoth'></div>";
    } 
   
