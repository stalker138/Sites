<?php
$countView = (int)$_POST['amt'];  // количество записей, получаемых за один раз
$startIndex = (int)$_POST['fst'];
    $db = new SQLite3($pb_root."admobj/objects.db");
    $return=Array();
    $sql="SELECT o.id as id, 
                 o.name as name,
                 o.type_id as type_id,
                 o.num as num,
                 o.area as area, 
                 o.year as year, 
                 o.adres as adres, 
                 o.latitude as latitude, 
                 o.longitude as longitude, 
                 o.descr as descr, 
                 MAX(j.id) as jid,
                 t.name as typeob,
                 p1.name as typepokr1, 
                 p2.name as typepokr2, 
                 p3.name as typepokr3, 
                 p4.name as typepokr4, 
                 p5.name as typepokr5,
                 p1.hrf as href1, 
                 p2.hrf as href2, 
                 p3.hrf as href3, 
                 p4.hrf as href4, 
                 p5.hrf as href5 
                 FROM myobjects as o 
    Left Join jobs as j on j.obj=o.id             
    Left Join typeobj as t on t.id=o.type_id 
    Left Join typepokr as p1 on p1.id=o.type_pokr1 
    Left Join typepokr as p2 on p2.id=o.type_pokr2 
    Left Join typepokr as p3 on p3.id=o.type_pokr3 
    Left Join typepokr as p4 on p4.id=o.type_pokr4 
    Left Join typepokr as p5 on p5.id=o.type_pokr5     
    GROUP BY o.id
    ORDER BY MAX(j.id) Desc LIMIT ".$countView." OFFSET ".$startIndex;
    $result = $db->query($sql);
    if($result!=''){
        while($row = $result->fetchArray(SQLITE3_ASSOC))
        {
            $return[]=$row;
        }
    }
    //if($startIndex!=0) $startIndex--;
   foreach($return as $row){
        echo "
          <fieldset class='fset' style=' min-width: calc(100% - 100px);'>
