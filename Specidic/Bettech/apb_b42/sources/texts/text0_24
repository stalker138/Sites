   if ((count($arr_f)==1) and !($arr_z)) {$type_pack=2;}//2-3 компонента - 1 строка на каждый компонент

 if ($type_pack == 0) {$colspan=(($kol_comp==2) ? 'colspan="3"' : 'colspan="5"');}
