function pack_explode($str_pack) {
// преобразование строки фасовок в массив
 $arr_pack=false;
 $str_pack=trim($str_pack);
 if ($str_pack=='') {return false;}
 $arr_rows = explode('/',$str_pack);
 foreach($arr_rows as $row){
  if (strpos($row, '=')){ //комплект
    $acompl=explode('=',$row);
    $compl = $acompl[1];
    $arow = explode('+',$acompl[0]);
    $arow[]=$compl;
    $arr_pack[]=$arow;
  }
  else {$arr_pack[] = $row;}
 }
 return $arr_pack;
}

function pack_compl($kol_comp=0) {
// строка комплекта
 $str_pack='';
 if ($kol_comp<2) {return '';}
 $str_pack='<tr><td style="min-width:30px; text-align:center;">Комп. «А»</td><td style="min-width:30px; text-align:center;">+</td><td style="min-width:30px; text-align:center;">Комп. «Б»</td>';
 if ($kol_comp==3) {
  $str_pack.='<td style="min-width:30px; text-align:center;">+</td><td style="min-width:30px; text-align:center;">Комп. «В»</td>';
 }
 $str_pack.='<td style="min-width:30px; text-align:center;">=</td><td>Комплект</td><td></td></tr>';
 return $str_pack;
}

function pack_set($n_mat=0, $arr_pack=false, $kol_comp=0, $s_begin='', $s_weight='', $o_weight=0) {
