 foreach($arr_pack as $arow){
   if ($kol_comp<2) {
     $str_pack.='<tr><td style="text-align:left;">'.$s_begin.(($s_begin=='') ? '' : ': ').$arow.'&nbsp;'.$s_weight;
     if ((float)$o_weight !=0) { $str_pack.=' – цена <span class="fwn c27">'.fc50($n_mat,$o_weight,150).'&nbsp;р.</span>';}
     $str_pack.='</td></tr>';
   }
   else {
    $str_pack.='<tr><td style="min-width:30px; text-align:center;">'.$arow[0].'</td><td style="min-width:30px; text-align:center;">+</td><td style="min-width:30px; text-align:center;">'.$arow[1].'</td>';
    if ($kol_comp>2) {$str_pack.='<td style="min-width:30px; text-align:center;">+</td><td style="min-width:30px; text-align:center;">'.$arow[2].'</td>';}
    $str_pack.='<td style="min-width:30px; text-align:center;">=</td><td>'.$arow[$kol_comp].'&nbsp;кг</td>';
    $str_pack.='<td>';
    if ((float)$o_weight !=0) { 
       if ($dop==1) {$price=fc50($n_mat,$o_weight,150)*2-200;}
       else {$price=fc50($n_mat,$o_weight,150);}
       //$str_pack.=' – цена <span class="fwn c27">'.$price.'&nbsp;р.</span>';
       $dop=1;
    }

    $str_pack.='</td></tr>';
   }
 }
 return $str_pack;
}



