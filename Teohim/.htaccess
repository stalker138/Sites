php_value display_errors 1
DirectoryIndex index.html index.htm index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^.htaccess$ -[F]

RewriteCond %{HTTP_HOST} ^www.teohim.ru$ [NC]
RewriteRule ^(.*)$ https://teohim.ru/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^2690505.ru$ [NC]
RewriteRule ^(.*)$ https://teohim.ru/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www.2690505.ru$ [NC]
RewriteRule ^(.*)$ https://teohim.ru/$1 [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(php|htm|html)\ HTTP/ 
RewriteRule ^index\.(php|htm|html)$ https://teohim.ru/ [R=301,L]
RewriteCond %{THE_REQUEST} ^(.*)\/index\.(php|htm|html)\ HTTP/ 
RewriteRule ^(.*)\/index\.(php|htm|html)$ https://teohim.ru/$1/ [R=301,L]

RewriteCond %{HTTP:X-HTTPS} !1
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

