/* Сравнение usort($a,"cmp"); */
function cmp($a,$b) {
  if($a[7]==$b[7]) {
    if ($a[0]==$b[0]) return 0;
    return ($a[0]<$b[0]) ? -1 : 1;
  }
  if ($a[7]=='200101') return -1;
  if ($b[7]=='200101') return 1;
  return ($a[7]>$b[7]) ? -1 : 1;
}

