function pack_explode($str_pack) {
// преобразование строки фасовок в массив
 $arr_pack=false;
 $str_pack=trim($str_pack);
 if ($str_pack=='') {return false;}
 $arr_rows = explode('/',$str_pack);
 foreach($arr_rows as $row){
  if (strpos($row, '=')){ //комплект
    $acompl=explode('=',$row);
    $compl = $acompl[1];
    $arow = explode('+',$acompl[0]);
    $arow[]=$compl;
    $arr_pack[]=$arow;
  }
  else {$arr_pack[] = $row;}
 }
 return $arr_pack;
}

function pack_compl($kol_comp=0) {
// строка комплекта
 $str_pack='';
 if ($kol_comp<2) {return '';}
 $str_pack='<tr><td>Комп.«А» &nbsp;</td><td>Комп.«Б» &nbsp;</td>';
 if ($kol_comp==3) {
  $str_pack.='<td>+Комп.«В» &nbsp;</td>';
 }
 $str_pack.='<td>= <span>Комплект</span></td></tr>';
 return $str_pack;
}

function pack_set($n_mat=0, $arr_pack=false, $kol_comp=0, $s_begin='', $s_weight='', $o_weight=0) {
// строка Фасовок
 $str_pack='';
 foreach($arr_pack as $arow){
   if ($kol_comp<2) {
     $str_pack.='<tr><td style="height:5px"></td></tr>
                 <tr><td>'.$s_begin.(($s_begin=='') ? '' : ': ').$arow.'&nbsp;'.$s_weight;
     if ((float)$o_weight !=0) { $str_pack.=' – цена <span class="fwn c27">'.fc50($n_mat,$o_weight,150).'&nbsp;р.</span>';}
     $str_pack.='</td></tr>';
   }
   else {
    $str_pack.='<tr><td>'.$arow[0].'кг</td><td>+ '.$arow[1].'кг</td>';
    if ($kol_comp>2) {$str_pack.='<td>+ '.$arow[2].'</td>';}
    $str_pack.='<td>= <span>'.$arow[$kol_comp].'кг</span></td>';
   }
 }
 return $str_pack;
}

function pack_set_o($n_mat=0, $arr_pack=false, $kol_comp=0, $s_begin='', $s_weight='', $o_weight=0, $type_pack=0) {
// строка Фасовок образцы
 $str_pack='';
 $colspan='';
 if ($type_pack == 0) {$colspan=(($kol_comp==2) ? 'colspan="3"' : 'colspan="5"');}
 if ($type_pack == 2) {$colspan='colspan="2"';}

 foreach($arr_pack as $arow){
   if ($kol_comp<2) {
     $str_pack.='<tr><td>'.$s_begin.(($s_begin=='') ? '' : ': ').$arow.$s_weight;
   } else {
     $str_pack.='<tr><td '.$colspan.'>'.$arow[0].' + '.$arow[1];
     if ($kol_comp>2) {$str_pack.=' + '.$arow[2];}

     $str_pack.=' = '.$arow[$kol_comp].$s_weight;
   }
   if ((float)$o_weight !=0) { $str_pack.=' – цена <span class="fwn c27">'.fc50($n_mat,$o_weight,150).'р</span>';}
   $str_pack.='</td></tr>';
 }
 return $str_pack;
}

function fmtr_packing($n_mat=0, $dop_nm='', $mw=0, $no_flex=0) {
// Вывод фасовки
 global $mtr_dop; 
 $type_pack = 0;
 $minw='';
 if ($mw > 0) { $minw=' min-width:'.$mw.'px;'; }
 $kol_comp=(int)$mtr_dop[$n_mat][7];
 $colspan='';
 $arr_f=pack_explode($mtr_dop[$n_mat][8]);
 $arr_z=pack_explode($mtr_dop[$n_mat][11]);
 $arr_o=pack_explode($mtr_dop[$n_mat][9]);
 if ($kol_comp==1) {$type_pack=1;}//однокомпонентный - таблица в одну строку
 else
   if ((count($arr_f)==1) and !($arr_z)) {$type_pack=2;}//2-3 компонента - 1 строка на каждый компонент

 if ($type_pack == 0) {$colspan=(($kol_comp==2) ? 'colspan="3"' : 'colspan="5"');}
 if ($type_pack == 2) {$colspan='colspan="2"';}
 $s_weight=(($n_mat==105 || $n_mat==227) ? 'л' : 'кг');
 if ($n_mat==39) {$s_weight='мл';} 
 $th_f='<tr><th class="fwb" style="padding-top:0;" '.$colspan.'>Фасовка: '.$dop_nm.'</th></tr>';
 $th_z='<tr><th class="fwb" '.$colspan.'>Фасовка под заказ:</th></tr>';
 $th_o='<tr><td '.$colspan.' style="height:1px"></td></tr>
        <tr><th class="fwb" '.$colspan.'>Образец-пробник:</th></tr>';
 $s_out='';
 if ($no_flex==0) {
   $s_out.='<div style="display:flex; align-items:flex-start;">'; }
 if ($type_pack==0){
 $s_out.='<table class="tfas" style="padding:2px;"><tbody>';

 $s_out.=$th_f;
 $s_out.=pack_compl($kol_comp);
 $s_out.=pack_set($n_mat, $arr_f, $kol_comp, trim($mtr_dop[$n_mat][12]), $s_weight);
 if ($arr_z) {
  $s_out.=$th_z;
  $s_out.=pack_set($n_mat, $arr_z, $kol_comp, trim($mtr_dop[$n_mat][12]), $s_weight);
 }
 if ($arr_o) {
  $s_out.=$th_o;
  $s_out.=pack_set_o($n_mat, $arr_o, $kol_comp, '', $s_weight, $mtr_dop[$n_mat][10], $type_pack);
 }
 }
 if ($type_pack==1) {
    $s_out.='<table class="tfas" style="padding:3px 5px; max-width:130px;"><tbody>
    <tr><td class="fs11 fwb">Фасовка: '.$dop_nm.'</td></tr><tr><td class="fs11" style="text-align:left;">';
    if ($arr_f) {
    $s_out.='<div class="px5"></div>'.trim($mtr_dop[$n_mat][12]).': <span class="fwn nw">'.$arr_f[0].$s_weight.'</span>';
    }
    if ($arr_z) {
    $s_out.='<div class="px5"></div><span class="fs10 fwn c50p">Под заказ (+18р/кг) :<br>'.trim($mtr_dop[$n_mat][12]).': <span class="fwn nw">'.$arr_z[0].$s_weight.'</span></span>';
    }
    if ($arr_o) {
    $s_out.='<div class="px5"></div>
    <span>Образец-пробник:</span><br>'.$arr_o[0].$s_weight.' – цена '.fc50($n_mat,$mtr_dop[$n_mat][10],150).'р.</td></tr>';
    }
 }
 if ($type_pack==2) {
    $s_out.='<table class="tfas" style="padding:5px; '.$minw.'"><tbody>
    <tr><td colspan="2" class="fwb">Фасовка: '.$dop_nm.'</td></tr>
    <tr><td>Компонент «А»</td><td class="tar">'.$arr_f[0][0].$s_weight.'</td></tr>
    <tr><td>Компонент «Б»</td><td class="tar">'.$arr_f[0][1].$s_weight.'</td></tr>';
    if ($kol_comp > 2) {
      $s_out.='<tr><td>Компонент «В»</td><td class="tar">'.$arr_f[0][2].$s_weight.'</td></tr>';}
    $s_out.='<tr><td class="fwb">Итого Комплект</td><td class="tar fwb">'.$arr_f[0][$kol_comp].$s_weight.'</td></tr>';
    if ($arr_o) {
     $s_out.=$th_o;
     $s_out.=pack_set_o($n_mat, $arr_o, $kol_comp, '', $s_weight, $mtr_dop[$n_mat][10], $type_pack);
    }
 }
 $s_out.='</tbody></table>';
 if ($no_flex==0) {
   $s_out.='</div>'; }
 print($s_out);
}

