/*
    Функция для удаления экранирующих символов "\" из содержимого POST-параметра
    Параметры: $name - имя принимаемого POST-параметра
    Возвращает содержимое без экранирующих слешей или false, если такого POST-параметра нет
*/
function Fo_post($name,$f=0) {
    $ret=$_POST[$name]; if ($ret==false) return false;
    $ret =  get_magic_quotes_gpc() ? stripslashes($ret) : $ret;
    return ($f==0 ? htmlspecialchars($ret) : $ret);
}
function Fo_tab($txt) {
    $ret=preg_replace('/\t/','    ',$txt);
    $ret=preg_replace('/\r/','',$ret);
    $ret=preg_replace('/\n/','',$ret);
    return $ret;
}
function Fo_test_file($htm) {
global $pb_root;
$pb_handler=@fopen($pb_root.'auto/test_file.htm','w');
if ($pb_handler) {
    @rewind($pb_handler);
    if (-1!=@fwrite($pb_handler,$htm)) { @ftruncate($pb_handler,ftell($pb_handler)); }
    @fflush($pb_handler); @fclose($pb_handler);
}
}
