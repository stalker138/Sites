    public $err_log;

    public $sendto = array();
    private $headers;
    private $smtpsendto = array();
    private $aattach = array();
    private $xheaders = array();

    private $priorities = array('1 (Highest)', '2 (High)', '3 (Normal)', '4 (Low)', '5 (Lowest)');
    private $charset = "utf-8";
    private $ctencoding = "8bit";
    private $receipt = 0;
    private $text_html = "text/plain"; // формат письма. по умолчанию текстовый

