    function __construct()
    {
        $this->autoCheck(false);
        $this->boundary = "--" . md5(uniqid("myboundary"));
        $this->charset = CHARSET;
        $this->smtp_serv = SMTP_SERVER;
        $this->smtp_login = SMTP_LOGIN;
        $this->smtp_pass = SMTP_PASSWORD;
        $this->smtp_port = SMTP_PORT;
        $this->smtp_timeout = SMTP_TIMEOUT;
        $this->mail_sender = MAIL_SENDER;
        $this->From($this->mail_sender);
        $this->err_log = '';
        if ($this->charset != "")
        {
            $this->charset = strtolower($this->charset);
            if ($this->charset == "us-ascii")
                $this->ctencoding = "7bit";
        }
    }

    public function Run($path) {
        $this->Subject($this->Theme);
        $this->To($this->Receiver);
        $this->Body($this->Body);
        //$this->GenerateBody($this->Header, $this->Body);
        if(!$this->SendEmail())
           $this->err_log = 'Error'.$this->err_log;
        $this->Finish();
    }
    
    function autoCheck($bool=false)
    {
        if ($bool)
            $this->checkAddress = true;
        else
            $this->checkAddress = false;
    }

    function Subject($subject)
    {
        $this->xheaders['Subject'] = "=?" . $this->charset . "?Q?" . str_replace("+", "_", str_replace("%", "=", urlencode(strtr($subject, "\r\n", "  ")))) . "?=";
        $this->subject = $subject;
    }

    function From($from)
    {

        if (!is_string($from))
        {
            $this->err_log.="Ошибка, From должен быть строкой<br>";
            //exit;
        }
        $this->xheaders['From'] = $from;
    }

    function ReplyTo($address)
    {

        if (!is_string($address))
            return false;

        $this->xheaders["Reply-To"] = $address;
    }

    function Receipt()
    {
        $this->receipt = 1;
    }

    function To($to)
    {
        // если это массив
        if (is_array($to))
        {
            $this->sendto = $to;
            foreach ($to as $key => $value)
            {
                $this->smtpsendto[$value] = $value;
            }
        }
        else
        {
            $this->sendto[] = $to;
            $this->smtpsendto[$to] = $to; // ключи и значения одинаковые, чтобы исключить дубли адресов
        }

        if ($this->checkAddress == true)
            $this->CheckAdresses($this->sendto);
    }

    function Body($body, $ContentType = "text/plain")
    {
         $this->text_html = $ContentType; // "text/html";
         $this->body = $body;
    }

    function GenerateBody($header, $rows, $text_html="html", $mailTemplate=null, $paragraphTemplate=null)
    {
        if (is_null($paragraphTemplate))
        {
            $templOID = $this->DBManager->GetOID('Template.MailParagraph');
            $templ = $this->DBManager->CreateObject($templOID);
            $templ->Retrieve();
            $paragraphTemplate = $templ->Body;
        }

        $body = '';
        foreach ($rows as $row)
        {
            $paragraph = !is_null($row) && ($row != '') ? $row : '<font color="red">[Параграф]</font>';

            $search = array('[Параграф]');
            $replace = array($paragraph);

            $body.= str_replace($search, $replace, $paragraphTemplate);
        }

        if (is_null($mailTemplate))
        {
            $templOID = $this->DBManager->GetOID('Template.Mail');
            $templ = $this->DBManager->CreateObject($templOID);
            $templ->Retrieve();
            $mailTemplate = $templ->Body;
        }

        $header = !is_null($header) && ($header != '') ? $header : '<font color="red">[Заголовок]</font>';
        $body = !is_null($body) && ($body != '') ? $body : '<font color="red">[Текст письма]</font>';
        //$number=!is_null($) && ($ != '') ? $ : '<font color="red">[Номер сообщения]</font>';
        $number='';
        $search = array('[Заголовок]', '[Текст письма]','[Номер сообщения]');
        $replace = array($header, $body,$number);

        $this->body = str_replace($search, $replace, $mailTemplate);

        if ($text_html == "html")
            $this->text_html = "text/html";
    }

    function Organization($org)
    {
        if (trim($org != ""))
            $this->xheaders['Organization'] = $org;
    }

    //приоритет письма
    function Priority($priority=3)
    {
        if (!intval($priority))
            return false;

        if (!isset($this->priorities[$priority - 1]))
            return false;

        $this->xheaders["X-Priority"] = $this->priorities[$priority - 1];
        return true;
    }

    /*
      $filename : путь к файлу
      $webi_filename : реальное имя файла
      $filetype : MIME-тип файла. по умолчанию 'application/x-unknown-content-type'
      $disposition : инструкция почтовому клиенту как отображать прикрепленный файл ("inline") как часть письма или ("attachment") как прикрепленный файл скомунизжено
     */

    function Attach($filename, $webi_filename="", $filetype = "", $disposition = "attachment")
    {
        if ($filetype == "")
            $filetype = "application/x-unknown-content-type";

        $this->aattach[] = $filename;
        $this->webi_filename[] = $webi_filename;
        $this->actype[] = $filetype;
        $this->adispo[] = $disposition;
    }

    function BuildMail()
    {
        $this->headers = "";
        $this->xheaders['To'] = implode(", ", $this->sendto);

        if ($this->receipt)
        {
            if (isset($this->xheaders["Reply-To"]))
                $this->xheaders["Disposition-Notification-To"] = $this->xheaders["Reply-To"];
            else
                $this->xheaders["Disposition-Notification-To"] = $this->xheaders['From'];
        }

        if ($this->charset != "")
        {
            $this->xheaders["Mime-Version"] = "1.0";
            $this->xheaders["Content-Type"] = $this->text_html . "; charset=$this->charset";
            $this->xheaders["Content-Transfer-Encoding"] = $this->ctencoding;
        }

        $this->xheaders["X-Mailer"] = $this->smtp_serv;
        // вставаляем файлы
        if (count($this->aattach) > 0)
        {
            $this->_build_attachement();
        } else
        {
            $this->fullBody = $this->body;
        }

        // разбиваем FROM на юзера и домен надо для заголовка
        $user_domen = explode('@', $this->xheaders['From']);
        $this->headers = "Date: " . date("D, j M Y G:i:s") . " +0700\r\n";
        $this->headers .= "Message-ID: <" . rand() . "." . date("YmjHis") . "@" . $user_domen[1] . ">\r\n";
        reset($this->xheaders);
        while (list( $hdr, $value ) = each($this->xheaders))
        {
            $this->headers .= $hdr . ": " . $value . "\r\n"; // пропускаем заголовок для отправки скрытой копии
        }
    }

    // включение отправки через smtp используя сокеты
    // для отправки через защищенное соединение сервер нужно указывать с добавлением "ssl://" например так "ssl://smtp.gmail.com"
