function img_resize($src, $dest, $quality=70, $rgb=0xFFFFFF) {
    if (!file_exists($src)) return false;
    $size = getimagesize($src);
    if ($size === false) return false;
    $format = strtolower(substr($size['mime'], strpos($size['mime'], '/')+1));
    $icfunc = "imagecreatefrom" . $format;
    if (!function_exists($icfunc)) return false;
    $w=$size[0]; $h=$size[1]; $r = $w / $h;
    if ($r>=1) {
        $w = ($w>800) ? 800 : (($w<400) ? 400 : $w);
        $h = floor($w/$r);
    } else {
        $h = ($h>800) ? 800 : (($h<400) ? 400 : $h);
        $w = floor($h/$r);
    }
    $format=($format=='gif' || $format=='png')?$format:'jpg';
    $isrc = $icfunc($src);
    $idest = imagecreatetruecolor($w, $h);
    imagefill($idest, 0, 0, $rgb);
    imagecopyresampled($idest, $isrc, 0, 0, 0, 0, $w, $h, $size[0], $size[1]);
    //if ($format=='gif' || $format=='png') {
    //    if ($format=='gif') imagegif($idest, $dest.'.gif');
    //    if ($format=='png') imagepng($idest, $dest.'.png');
    //} else { imagejpeg($idest, $dest.'.jpg', $quality); $format='jpg'; }
    imagejpeg($idest, $dest.'.jpg', $quality); $format='jpg';
    imagedestroy($isrc);
    imagedestroy($idest);
    return $format;  
}
