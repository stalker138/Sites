<tr><td class="tdl">Стяжки М100-М150</td><td>250..300</td><td>150..200</td><td>400..500</td></tr>
<tr><td class="tdl">Стяжки М150-М250</td><td>200..250</td><td>100..150</td><td>300..400</td></tr>
