function fmtr_links($n_mat=0, $a_lnk_nm=false) {
//вывод группировочных ссылок по индексe материалов 
 global $a_mtr_links, $a_gr_link;
 $s_out='';
 $a_lnk=false;
 foreach($a_mtr_links as $a_links){
   if (in_array($n_mat, $a_links[1])) {
     $a_lnk = $a_links[0];
     break;
   }
 }
 $s_out = '<div class="dblinkr">';
 if ($a_lnk==false) return;
 $j = 0;
 foreach($a_lnk as $ndx_lnk){ 
   $a_anc = false;
   if ($a_lnk_nm==false) {$slnk = $a_gr_link[$ndx_lnk][1];}
   else {$slnk = $a_lnk_nm[$j];}
   $a_anc = explode('%',$slnk);
   $s_out .= '<p class="fwb fs13">';
   $s_out .= $a_anc[0].$a_gr_link[$ndx_lnk][0].$a_anc[1].'</a>'.$a_anc[2];
   $s_out .= '</p>';
   $j+=1;
 }
 $s_out .= '</div>'; 
 print($s_out);
}

function fmtr_micro($n_mat=0, $name="") {
//вывод микроразметки страницы по массиву индексов материалов 
 global $mtr,$mtr_dop,$pb_domain,$pb_full_url;
 $s_out='';
   if ($name=='') { $name=$mtr_dop[$n_mat][14];}
   $price=preg_replace('/[^0-9]+/', '', $mtr[$n_mat][8]);
   $s_out.='
   <meta itemprop="name" content="'.$name.'">
   <link itemprop="image" href="'.$pb_domain.'/img/mtr/p'.$n_mat.'.png" />
   <div itemprop="brand" itemscope itemtype="https://schema.org/Brand">
   <meta itemprop="name" content="Элакор">
   </div>';
   $s_out.='
   <div itemprop="offers" itemscope itemtype="https://schema.org/AggregateOffer">
   <meta itemprop="lowPrice" content="'.$price.'">
   <meta itemprop="priceCurrency" content="RUB">
   <link itemprop="url" href="'.$pb_domain.$pb_full_url.'" />
   </div>';
 print($s_out);
}

