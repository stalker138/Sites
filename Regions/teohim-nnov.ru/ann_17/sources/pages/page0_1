<?php
// page0_1 - вывод изображения капчи. Используется страницами с формами обратной связи.
// $pb_root - переменная, вставляемая генератором - путь к "корневой" папке (значение берется из переменной $pb_path_root - см. файл config.php)
$width=70; $height=25; $color1=0; $color2=200; $backgr=0; $s=''; $f='';
if (!empty($_GET['w'])) $width=(int)$_GET['w'];    // Ширина рисунка капчи
if (!empty($_GET['h'])) $height=(int)$_GET['h'];   // Высота рисунка капчи
if (!empty($_GET['c1'])) $color1=(int)$_GET['c1']; // Начало диапазона цветов RGB (от 0 до 255) - одно значение для всех цветов
if (!empty($_GET['c2'])) $color2=(int)$_GET['c2']; // Конец диапазона цветов RGB (от 0 до 255) - одно значение для всех цветов
if (!empty($_GET['b'])) $backgr=(int)$_GET['b'];   // Фон, если 0 то прозрачный, иначе фон RGB - одно значение для всех цветов
if (!empty($_GET['f'])) $f=(int)$_GET['f'];           // Часть имени файла капчи
if (!empty($_GET['t'])) $s=$_GET['t']; else { header("HTTP/1.1 204 No Content"); exit; } // Время в формате date("YmdHis")
$txt_captcha=@file_get_contents($pb_root.'auto/pb_captcha'.$f.'.php'); $len=$s.chr(9).$_SERVER['REMOTE_ADDR'].chr(9);
$pos=strpos($txt_captcha,chr(10).$len); if ($pos==false) { header("HTTP/1.1 204 No Content"); exit; }
$txt_captcha=substr($txt_captcha,$pos+strlen($len)+1); $pos=strpos($txt_captcha,chr(10)); $s=strtoupper(substr($txt_captcha,0,$pos));
if ($backgr==0) { $transparent=1; $backgr=array(0,0,1); } else { $transparent=0; $backgr=explode(',',$backgr); }
$im=imagecreate($width, $height); $len=strlen($s); $height-=10;
$stepx=(int)$width/$len; if ($stepx<2) $stepx=1; $stepy=(int)$height/5;
$x=(int)($width-$stepx*$len)/2+$width/20-1; if (mt_rand(1,10)<6) $y=($height+5)/2-$stepy; else $y=$height/2-$stepy;
$backgr=imagecolorallocate($im, (int)$backgr[0], (int)$backgr[1], (int)$backgr[2]);
if ($transparent) imageColorTransparent($im, $backgr);
imagefilledrectangle($im,0,0,$width-1,$height+9,$backgr); 
imageRectangle($im,0,0,$width-1,$height+9, imagecolorallocate($im, mt_rand($color1,$color2), mt_rand($color1,$color2), mt_rand($color1,$color2)));
for ($i=0; $i<$len; $i++) {
    $font=mt_rand(3,5); imagestring($im, $font, $x, $y, $s[$i], imagecolorallocate($im, mt_rand($color1,$color2), mt_rand($color1,$color2), mt_rand($color1,$color2)));
    $x+=$stepx; $y = (int) ($height+5)/2 + ($y<($height+5)/2-$stepy ? $stepy : -$stepy)-imagefontheight($font)/2;
}
header("Content-type: image/png");
imagepng($im);
imagedestroy($im);
?>
