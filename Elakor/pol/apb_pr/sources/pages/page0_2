<?php
// 2016 | ajax post get_cnew (a new generation of CAPTCHA and returns a URL to display an image of a new CAPTCHA)

if (empty($_POST['c_new']) || empty($_POST['ncap'])) { header("HTTP/1.1 204 No Content"); exit; } else { $sessionID=(int)($_POST['c_new']); $n=(int)($_POST['ncap']); }
if ($n<1 || $n>99) $n=1; // Part of the file name CAPTCHA
$pb_file_captcha=$pb_root.'auto/pb_captcha'; $pb_file_captcha.=$n.'.php'; // Text files captcha
$out='error'; $cr=chr(10); // Line Break (linux format)
$w=50; $h=25;  // The width-height picture captcha
$c1=0; $c2=200; // The range for the colors R, G, B
$b=0; // Background (if 0 is transparent) otherwise $pb_background='r,g,b'
$cnt=3; // Number of characters in a CAPTCHA
if (file_exists($pb_file_captcha)) $pb_txt=@file_get_contents($pb_file_captcha); else $pb_txt='<?php'.$cr.'print "hello"; exit; $t="'.$cr.'";'.$cr.'?>'.$cr;
if ($pb_txt==false) { print 'error'; exit; } // If the file could not be read

$vcap=date("i"); $vcap = ($vcap<'10') ? date("YmdH",time()-3600) : date("YmdH");
$cap=strpos($pb_txt,$cr.$vcap,0);
if ($cap) $pb_txt='<?php'.$cr.'print "hello"; exit; $t="'.substr($pb_txt,$cap);
else { $vcap=date("Ymd",time()-86400); $cap=strpos($pb_txt,$cr.$vcap,0); if ($cap) $pb_txt='<?php'.$cr.'print "hello"; exit; $t="'.substr($pb_txt,$cap); }

$cap=''; $vcap=date("YmdHis").$sessionID;
for ($i=1; $i<=$cnt; $i++) { $s=array(chr(mt_rand(49,57)),chr(mt_rand(49,57)),chr(mt_rand(49,57))); $cap.=$s[mt_rand(1,3)-1]; }
$pb_txt=substr($pb_txt,0,strpos($pb_txt,$cr.'";'.$cr.'?>'.$cr,0)).$cr.$vcap.chr(9).$_SERVER['REMOTE_ADDR'].chr(9).$cap.$cr.'";'.$cr.'?>'.$cr;
$pb_handler=@fopen($pb_file_captcha,'w');
if ($pb_handler) {
    @rewind($pb_handler);
    if (-1!=@fwrite($pb_handler,$pb_txt)) {
        @ftruncate($pb_handler,ftell($pb_handler));
        $out='/auto/get_cimg.php?t='.$vcap.'&w='.$w.'&h='.$h.'&c1='.$c1.'&c2='.$c2.'&b='.$b.'&n='.$n;
    } @fflush($pb_handler); @fclose($pb_handler);
}
print $out;
?>