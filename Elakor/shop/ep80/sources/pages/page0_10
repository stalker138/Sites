function f_navShema($link='', $name='', $level=1) {
$li = '<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">';
$a =  ' itemprop="item"';
$s = '<span itemprop="name">';
$p = '<meta itemprop="position" content="';
$name = $s.$name.'</span>'; $p.=$level.'">';
if ($link) $link = substr($link,0,strpos($link,'>')).$a.'>'.$name.'<'.'/a>';
return $li.( empty($link) ? $name : $link ).$p.'</li>'.( empty($link) ? '' : '<li class="navs">•</li>' );
}
