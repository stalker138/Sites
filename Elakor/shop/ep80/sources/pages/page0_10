function f_navShema($link='', $name='', $level=1) {
$li = '<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">';
$a =  ' itemprop="item"';
$s = '<span itemprop="name">';
$p = '<meta itemprop="position" content="';
$name = $s.$name.'</span>'; $p.=$level.'">';
if ($link) {
//$link = $pb_domain.substr($link, 9, strlen($link)-9);
//$link = substr($link,0,strpos($link,'>')).$a.'>'.$name.'<'.'/a>';
$href =  'href="'.$pb_domain.substr($link, 9, strlen($link)-15).'"';
$link = '<a '.$href.$a.'>'.$name.'</a>';
}
return $li.( empty($link) ? $name : $link ).$p.'</li>'.( empty($link) ? '' : '<li class="navs">•</li>' );
}

function f_navMat($num=0) {
   global $a_navmat, $a_catmat, $a_mtr_dop;
   $ndx=0;
   for ($i=11; $i<count($a_catmat); $i++) {
      if (in_array($num, $a_catmat[$i])) {
         $ndx = $i;
         break;
      }
   }
   if ($ndx==0) { return; }
   $level=1;
   $out='';
   for ($i=0; $i<count($a_navmat[$ndx][0]); $i++) {
      $url=$a_navmat[$ndx][0][$i];
      $name=$a_navmat[$ndx][1][$i];
      $out.=f_navShema($url, $name, $level);
      $level++;
   }
   $out.= f_navShema('', $a_mtr_dop[$num][0], $level);
   print($out);
}
