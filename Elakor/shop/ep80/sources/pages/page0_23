function pack_explode($str_pack) {
// преобразование строки фасовок в массив
 $arr_pack=false;
 $str_pack=trim($str_pack);
 if ($str_pack=='') {return false;}
 $arr_rows = explode('/',$str_pack);
 foreach($arr_rows as $row){
  if (strpos($row, '=')){ //комплект
    $acompl=explode('=',$row);
    $compl = $acompl[1];
    $arow = explode('+',$acompl[0]);
    $arow[]=$compl;
    $arr_pack[]=$arow;
  }
  else {$arr_pack[] = $row;}
 }
 return $arr_pack;
}

function pack_compl($kol_comp=0) {
// строка комплекта
 $str_pack='';
 if ($kol_comp<2) {return '';}
 $str_pack='<tr><td>Комп. «А»</td><td>+</td><td>Комп. «Б»</td>';
 if ($kol_comp==3) {
  $str_pack.='<td>+</td><td>Комп. «В»</td>';
 }
 $str_pack.='<td>=</td><td>Комплект</td><td></td></tr>';
 return $str_pack;
}

function pack_set($n_mat=0, $arr_pack=false, $kol_comp=0, $s_begin='', $s_weight='', $o_weight=0) {
// строка Фасовок
 $str_pack='';
 foreach($arr_pack as $arow){
   if ($kol_comp<2) {
     $str_pack.='<tr><td style="text-align:left;">'.$s_begin.(($s_begin=='') ? '' : ': ').$arow.'&nbsp;'.$s_weight;
     if ((float)$o_weight !=0) { $str_pack.=' – цена <span class="fwn c27">'.fc50($n_mat,$o_weight,150).'&nbsp;р.</span>';}
     $str_pack.='</td></tr>';
   }
   else {
    $str_pack.='<tr><td>'.$arow[0].'</td><td>+</td><td>'.$arow[1].'</td>';
    if ($kol_comp>2) {$str_pack.='<td>+</td><td>'.$arow[2].'</td>';}
    $str_pack.='<td>=</td><td>'.$arow[$kol_comp].'&nbsp;кг</td>';
    $str_pack.='<td>';
    if ((float)$o_weight !=0) { 
       if ($dop==1) {$price=fc50($n_mat,$o_weight,150)*2-200;}
       else {$price=fc50($n_mat,$o_weight,150);}
       $str_pack.=' – цена <span class="fwn c27">'.$price.'&nbsp;р.</span>';
       $dop=1;
    }

    $str_pack.='</td></tr>';
   }
 }
 return $str_pack;
}



