function fltout_gr($alist=false, $a_fs0=false, $ii=0) {
  global $a_flt, $a_fs, $pb_root, $i_pkr;
  if ($alist==false) {return false;}
  $alist_out=false;
  $cnt = count($alist);
  $lj=count($a_fs0);
  for ($ip=0; $ip<$cnt; $ip++) {
      $f=0;$fs0=0;
      for ($j=1;$j<$lj;$j++) {
        $fs = $a_fs0[$j]; /* флажок */
        $flt = $a_flt[$alist[$ip]][$ii][$j]; /* позиция, соответствующая флажку */
        if ($fs==1) {$fs0=1;}//был установлен хотя бы один фильтр в группе. Если $fs0 будет равен 0, то значит в группе фильтры не установлены, и список покрытий не меняется
        if (($fs==1 && $flt==1)) { /* установленный Флажок совпадает с 1 в столбце покрытия */
          $f=1; 
        }
      }
      if ($f==1 || $fs0==0){$alist_out[]=$alist[$ip];}
  }
  return $alist_out;
}

