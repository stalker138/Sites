/*
    Функция для удаления экранирующих символов "\" из содержимого GET-параметра
    Параметры: $name - имя принимаемого GET-параметра
    Возвращает содержимое без экранирующих слешей или false, если такого GET-параметра нет
*/
function Fo_get($name,$f=0) {
    $ret=$_GET[$name]; if ($ret==false) return false;
    $ret =  get_magic_quotes_gpc() ? stripslashes($ret) : $ret;
    return ($f==0 ? htmlspecialchars($ret) : $ret);
}
